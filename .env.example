# این فایل رو کپی کن به .env و مقادیر واقعی رو جایگزین کن
# سپس مطمئن شو دسترسی فایل محدوده: chmod 600 .env

PORT=3000
REDIS_URL=redis://127.0.0.1:6379

# همون رمز مشترکی که موقع setWebhook به تلگرام دادی
WEBHOOK_SECRET=یه-رشته-تصادفی-طولانی-اینجا

# کلید API دیپ‌سیک (برای گزارش عملیات روانی، سناریوساز، کپشن‌ساز)
DEEPSEEK_API_KEY=

# اختیاری — برای تب «رصد یوتیوب». اگه خالی بمونه، اون بخش غیرفعال می‌مونه
YOUTUBE_API_KEY=

# آدرس Worker واسط رو Cloudflare (برای دورزدن فیلترینگ یوتیوب)
RELAY_URL=https://eshraf-relay.galexytab50.workers.dev
# باید دقیقاً با RELAY_SECRET که رو خودِ Worker (Cloudflare) تنظیم می‌کنی یکی باشه
RELAY_SECRET=91c9951252059a744347af23ee047c13b8e3cc89408468b6

# یوزرنیم کانال تلگرام (بدون @)
TELEGRAM_CHANNEL_USERNAME=syriamonitoring

# چون پشت Nginx با HTTPS هستیم، این باید true بمونه
COOKIE_SECURE=true
